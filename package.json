{
  "name": "learning-patterns",
  "private": true,
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "test": "node --test",
    "typecheck": "tsc --checkJs --noEmit",
    "types": "tsc -p tsconfig.types.json",
    "types:check": "node scripts/check-types.mjs",
    "budget": "node scripts/check-budget.mjs",
    "demo": "node scripts/build-demo.mjs",
    "test:browser": "playwright test --workers=2",
    "preview:deploy": "npm run demo && npx wrangler@4 deploy",
    "icons": "node scripts/build-icons.mjs"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.2",
    "@fontsource/source-sans-3": "^5.3.0",
    "@fontsource/source-serif-4": "^5.3.0",
    "@playwright/test": "^1.56.0",
    "@tabler/icons": "^3.49.0",
    "typescript": "^5.9.3"
  }
}
