{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Hint ladder content",
  "type": "object",
  "required": ["title", "question", "options", "correct", "hints", "worked", "followUp"],
  "additionalProperties": false,
  "x-optionReference": "correct",
  "properties": {
    "title": { "type": "string", "minLength": 1, "maxLength": 120 },
    "context": { "type": "string", "minLength": 1, "maxLength": 600 },
    "question": { "type": "string", "minLength": 1, "maxLength": 400 },
    "options": {
      "type": "array", "minItems": 3, "maxItems": 4, "x-uniqueBy": "id", "x-feedbackUnlessCorrect": true,
      "items": {
        "type": "object", "required": ["id", "text"], "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "minLength": 1, "pattern": "^[a-zA-Z0-9_-]+$", "maxLength": 120 },
          "text": { "type": "string", "minLength": 1, "maxLength": 300 },
          "feedback": { "type": "string", "minLength": 1, "maxLength": 600 }
        }
      }
    },
    "correct": { "type": "string", "minLength": 1, "maxLength": 120 },
    "hints": {
      "type": "array", "minItems": 1, "maxItems": 3,
      "items": { "type": "string", "minLength": 1, "maxLength": 400 }
    },
    "worked": { "type": "string", "minLength": 1, "maxLength": 600 },
    "followUp": {
      "type": "object",
      "required": ["question", "options", "correct", "explanation"],
      "additionalProperties": false,
      "x-optionReference": "correct",
      "properties": {
        "question": { "type": "string", "minLength": 1, "maxLength": 400 },
        "options": {
          "type": "array", "minItems": 2, "maxItems": 4, "x-uniqueBy": "id",
          "items": {
            "type": "object", "required": ["id", "text"], "additionalProperties": false,
            "properties": {
              "id": { "type": "string", "minLength": 1, "pattern": "^[a-zA-Z0-9_-]+$", "maxLength": 120 },
              "text": { "type": "string", "minLength": 1, "maxLength": 300 }
            }
          }
        },
        "correct": { "type": "string", "minLength": 1, "maxLength": 120 },
        "explanation": { "type": "string", "minLength": 1, "maxLength": 600 }
      }
    }
  }
}
