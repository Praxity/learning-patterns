{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Review prompts content",
  "type": "object",
  "required": ["title", "parts", "reviewDays"],
  "additionalProperties": false,
  "properties": {
    "title": { "type": "string", "minLength": 1 },
    "parts": {
      "type": "array", "minItems": 1, "x-uniqueBy": "id",
      "items": {
        "type": "object",
        "required": ["id", "heading", "paragraphs", "question", "answer"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "minLength": 1, "pattern": "^[a-zA-Z0-9_-]+$" },
          "heading": { "type": "string", "minLength": 1 },
          "paragraphs": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
          "question": { "type": "string", "minLength": 1 },
          "answer": { "type": "string", "minLength": 1 }
        }
      }
    },
    "reviewDays": {
      "type": "object", "required": ["remembered", "forgot"], "additionalProperties": false,
      "properties": {
        "remembered": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 },
        "forgot": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 }
      }
    }
  }
}
