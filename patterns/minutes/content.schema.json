{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Minutes per section content",
  "type": "object",
  "required": ["title", "rates", "sections"],
  "additionalProperties": false,
  "properties": {
    "title": { "type": "string", "minLength": 1 },
    "rates": {
      "type": "object", "required": ["readingWordsPerMinute", "minutesPerQuestion"], "additionalProperties": false,
      "properties": {
        "readingWordsPerMinute": { "type": "number", "exclusiveMinimum": 0, "maximum": 9007199254740991 },
        "minutesPerQuestion": { "type": "number", "minimum": 0, "maximum": 9007199254740991 }
      }
    },
    "sections": {
      "type": "array", "minItems": 1, "x-uniqueBy": "id",
      "items": {
        "type": "object", "required": ["id", "title", "words", "questions", "narrationSeconds"], "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "minLength": 1, "pattern": "^[a-zA-Z0-9_-]+$" },
          "title": { "type": "string", "minLength": 1 },
          "words": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
          "questions": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
          "narrationSeconds": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 }
        }
      }
    }
  }
}
