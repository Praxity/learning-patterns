{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Test-out content",
  "type": "object",
  "required": ["title", "allowTestOut", "sections", "questions"],
  "additionalProperties": false,
  "x-sectionQuestions": { "min": 1, "max": 2 },
  "properties": {
    "title": { "type": "string", "minLength": 1, "pattern": "\\S", "maxLength": 120 },
    "allowTestOut": { "type": "boolean" },
    "sections": {
      "type": "array", "minItems": 1, "x-uniqueBy": "id", "x-acyclicReferences": "requires",
      "items": {
        "type": "object", "required": ["id", "title", "requires"], "additionalProperties": false,
        "properties": {
          "id": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 },
          "title": { "type": "string", "minLength": 1, "pattern": "\\S", "maxLength": 120 },
          "requires": { "type": "array", "uniqueItems": true, "items": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 } }
        }
      }
    },
    "questions": {
      "type": "array", "minItems": 1, "x-uniqueBy": "id",
      "items": {
        "type": "object", "required": ["id", "section", "text", "options", "correct", "explanation"], "additionalProperties": false,
        "x-sectionReference": "section", "x-optionReference": "correct",
        "properties": {
          "id": { "type": "string", "minLength": 1, "pattern": "^[a-zA-Z0-9_-]+$", "maxLength": 120 },
          "section": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 },
          "text": { "type": "string", "minLength": 1, "pattern": "\\S", "maxLength": 400 },
          "correct": { "type": "string", "minLength": 1, "pattern": "\\S", "maxLength": 120 },
          "explanation": { "type": "string", "minLength": 1, "pattern": "\\S", "maxLength": 1500 },
          "options": {
            "type": "array", "minItems": 2, "x-uniqueBy": "id",
            "items": {
              "type": "object", "required": ["id", "text"], "additionalProperties": false,
              "properties": {
                "id": { "type": "string", "minLength": 1, "pattern": "^[a-zA-Z0-9_-]+$", "maxLength": 120 },
                "text": { "type": "string", "minLength": 1, "pattern": "\\S", "maxLength": 300 }
              }
            }
          }
        }
      }
    }
  }
}
