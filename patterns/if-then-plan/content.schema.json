{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "If-then plan content",
  "type": "object",
  "required": ["title", "context", "when", "will", "dateLabel"],
  "additionalProperties": false,
  "properties": {
    "title": { "type": "string", "minLength": 1, "maxLength": 120 },
    "context": { "type": "string", "minLength": 1, "maxLength": 400 },
    "when": { "$ref": "#/$defs/step" },
    "will": { "$ref": "#/$defs/step" },
    "dateLabel": { "type": "string", "minLength": 1, "maxLength": 120 }
  },
  "$defs": {
    "step": {
      "type": "object",
      "required": ["options"],
      "additionalProperties": false,
      "properties": {
        "options": {
          "type": "array", "minItems": 3, "maxItems": 5, "x-uniqueBy": "id", "x-minWithout": { "field": "vague", "count": 2 },
          "items": {
            "type": "object", "required": ["id", "text"], "additionalProperties": false,
            "properties": {
              "id": { "type": "string", "minLength": 1, "maxLength": 120, "pattern": "^[a-zA-Z0-9_-]+$" },
              "text": { "type": "string", "minLength": 1, "maxLength": 300 },
              "vague": { "type": "string", "minLength": 1, "maxLength": 400 }
            }
          }
        }
      }
    }
  }
}
