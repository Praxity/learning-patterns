{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Highlight content",
  "type": "object",
  "required": ["mode", "title", "paragraphs"],
  "additionalProperties": false,
  "properties": {
    "mode": { "enum": ["key", "evidence"] },
    "title": { "type": "string", "pattern": "\\S" },
    "question": { "type": "string", "pattern": "\\S" },
    "paragraphs": {
      "type": "array",
      "minItems": 1,
      "x-uniqueChunkIds": true,
      "description": "Chunk ids are unique across every paragraph; validateContent enforces this annotation.",
      "contains": { "type": "array", "contains": { "type": "object", "required": ["key"], "properties": { "key": { "const": true } } } },
      "items": {
        "type": "array",
        "minItems": 1,
        "items": {
          "type": "object",
          "required": ["id", "text"],
          "additionalProperties": false,
          "properties": {
            "id": { "type": "string", "pattern": "^[a-zA-Z0-9_-]+$" },
            "text": { "type": "string", "pattern": "^\\S(?:[\\s\\S]*\\S)?$" },
            "key": { "type": "boolean" },
            "note": { "type": "string", "pattern": "\\S" }
          }
        }
      }
    }
  },
  "if": { "properties": { "mode": { "const": "evidence" } } },
  "then": { "required": ["question"] }
}
