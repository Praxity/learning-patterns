{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Spot the misconception content",
  "type": "object",
  "required": ["question", "keyIdea", "model", "unsureKeyIdea", "unsureMisconception", "noMatch", "misconceptions"],
  "additionalProperties": false,
  "properties": {
    "question": { "type": "string", "minLength": 1, "maxLength": 400 },
    "keyIdea": { "type": "string", "minLength": 1, "maxLength": 120 },
    "model": { "type": "string", "minLength": 1, "maxLength": 1500 },
    "unsureKeyIdea": { "type": "string", "minLength": 1, "maxLength": 1500 },
    "unsureMisconception": { "type": "string", "allOf": [{ "pattern": "\\{idea\\}" }, { "pattern": "\\{why\\}" }], "maxLength": 1500 },
    "noMatch": { "type": "string", "minLength": 1, "maxLength": 1500 },
    "misconceptions": {
      "type": "array", "minItems": 4, "maxItems": 4,
      "prefixItems": [
        { "$ref": "#/$defs/misconception", "properties": { "id": { "const": "rereading" } } },
        { "$ref": "#/$defs/misconception", "properties": { "id": { "const": "highlighting" } } },
        { "$ref": "#/$defs/misconception", "properties": { "id": { "const": "cramming" } } },
        { "$ref": "#/$defs/misconception", "properties": { "id": { "const": "watching" } } }
      ],
      "items": false
    }
  },
  "$defs": {
    "misconception": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "label", "idea", "why"],
      "properties": {
        "id": { "type": "string", "enum": ["rereading", "highlighting", "cramming", "watching"], "maxLength": 120 },
        "label": { "type": "string", "minLength": 1, "maxLength": 120 },
        "idea": { "type": "string", "minLength": 1, "maxLength": 1500 },
        "why": { "type": "string", "minLength": 1, "maxLength": 1500 }
      }
    }
  }
}
