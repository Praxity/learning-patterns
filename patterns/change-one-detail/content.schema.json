{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Change one detail content",
  "type": "object",
  "required": ["title", "case", "question", "options", "correct", "explanation", "changes", "rule"],
  "additionalProperties": false,
  "x-optionReference": "correct",
  "properties": {
    "title": { "type": "string", "minLength": 1, "maxLength": 120 },
    "context": { "type": "string", "minLength": 1, "maxLength": 400 },
    "case": { "type": "string", "minLength": 1, "maxLength": 600 },
    "question": { "type": "string", "minLength": 1, "maxLength": 400 },
    "options": {
      "type": "array", "minItems": 2, "maxItems": 4, "x-uniqueBy": "id",
      "items": {
        "type": "object", "required": ["id", "text"], "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "minLength": 1, "pattern": "^[a-zA-Z0-9_-]+$", "maxLength": 120 },
          "text": { "type": "string", "minLength": 1, "maxLength": 300 }
        }
      }
    },
    "correct": { "type": "string", "minLength": 1, "maxLength": 120 },
    "explanation": { "type": "string", "minLength": 1, "maxLength": 600 },
    "changes": {
      "type": "array", "minItems": 1, "maxItems": 3, "x-oneDiffers": "correct",
      "items": {
        "type": "object", "required": ["from", "to", "correct", "explanation"], "additionalProperties": false,
        "properties": {
          "from": { "type": "string", "minLength": 1, "maxLength": 120, "x-occursOnceIn": "case" },
          "to": { "type": "string", "minLength": 1, "maxLength": 120 },
          "correct": { "type": "string", "minLength": 1, "maxLength": 120 },
          "explanation": { "type": "string", "minLength": 1, "maxLength": 600 }
        }
      }
    },
    "rule": { "type": "string", "minLength": 1, "maxLength": 400 }
  }
}
