{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Self-check content",
  "type": "object",
  "required": [
    "task",
    "parts",
    "model"
  ],
  "additionalProperties": false,
  "properties": {
    "task": {
      "type": "string",
      "minLength": 1,
      "maxLength": 400
    },
    "model": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1500
    },
    "parts": {
      "type": "array",
      "minItems": 1,
      "x-uniqueBy": "id",
      "items": {
        "type": "object",
        "required": [
          "id",
          "label",
          "missed",
          "evidence"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "pattern": "^[a-zA-Z0-9_-]+$",
            "maxLength": 120
          },
          "label": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120
          },
          "missed": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1500
          },
          "evidence": {
            "type": [
              "string",
              "null"
            ],
            "minLength": 1,
            "x-occursOnceIn": "model",
            "description": "An exact substring occurring once in model, or null for a whole-answer part. validateContent checks the substring constraint.",
            "maxLength": 1500
          }
        }
      }
    },
    "context": {
      "type": "object",
      "required": [
        "to",
        "initials",
        "subject"
      ],
      "additionalProperties": false,
      "properties": {
        "to": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "initials": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "subject": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "placeholder": {
          "type": "string",
          "maxLength": 120
        }
      }
    }
  }
}
