{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Which is better, and why content",
  "type": "object",
  "required": ["title", "context", "versions", "better", "qualities"],
  "additionalProperties": false,
  "$defs": {
    "email": {
      "type": "object", "required": ["subject", "greeting", "body", "signoff"], "additionalProperties": false,
      "description": "One version of the email. Only body sentences can be picked.",
      "properties": {
        "subject": { "type": "string", "minLength": 1, "maxLength": 120 },
        "greeting": { "type": "string", "minLength": 1, "maxLength": 120 },
        "body": {
          "type": "array", "minItems": 1, "maxItems": 3,
          "x-sentences": "two to six in all",
          "description": "Paragraphs, each a list of sentences. Sentences are numbered from 1 across the paragraphs.",
          "items": { "type": "array", "minItems": 1, "maxItems": 6, "items": { "type": "string", "minLength": 1, "maxLength": 300 } }
        },
        "signoff": { "type": "string", "minLength": 1, "maxLength": 200, "description": "A line break (\n) starts a new line, as in \"Thanks,\nSam Rivera\"." }
      }
    }
  },
  "properties": {
    "title": { "type": "string", "minLength": 1, "maxLength": 120 },
    "context": { "type": "string", "minLength": 1, "maxLength": 400 },
    "versions": {
      "type": "object", "required": ["a", "b"], "additionalProperties": false,
      "description": "Two versions of the same email.",
      "properties": {
        "a": { "$ref": "#/$defs/email" },
        "b": { "$ref": "#/$defs/email" }
      }
    },
    "better": { "enum": ["a", "b"], "description": "The better version. Every sentence answer is in it." },
    "qualities": {
      "type": "array", "minItems": 2, "maxItems": 4,
      "x-oneNamesSentence": true, "x-uniqueBy": "sentence",
      "items": {
        "type": "object", "required": ["question", "sentence", "reason", "note"], "additionalProperties": false,
        "properties": {
          "question": { "type": "string", "minLength": 1, "maxLength": 400 },
          "sentence": {
            "type": ["integer", "null"], "minimum": 1, "maximum": 6,
            "description": "The body sentence in the better version that shows the quality, counted from 1 across its paragraphs, or null when neither version does."
          },
          "reason": { "type": "string", "minLength": 1, "maxLength": 600 },
          "note": { "type": "string", "minLength": 1, "maxLength": 120 }
        }
      }
    }
  }
}
