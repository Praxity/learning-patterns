{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "I don't know content",
  "type": "object",
  "required": ["title", "questions", "points"],
  "additionalProperties": false,
  "properties": {
    "title": { "type": "string", "minLength": 1, "maxLength": 120 },
    "questions": {
      "type": "array", "minItems": 1, "x-uniqueBy": "id",
      "items": {
        "type": "object",
        "required": ["id", "text", "options", "correct", "explanation"],
        "additionalProperties": false,
        "x-optionReference": "correct",
        "properties": {
          "id": { "type": "string", "minLength": 1, "pattern": "^[a-zA-Z0-9_-]+$", "maxLength": 120 },
          "text": { "type": "string", "minLength": 1, "maxLength": 400 },
          "correct": { "type": "string", "minLength": 1, "maxLength": 120 },
          "explanation": { "type": "string", "minLength": 1, "maxLength": 1500 },
          "options": {
            "type": "array", "minItems": 1, "x-uniqueBy": "id",
            "items": {
              "type": "object", "required": ["id", "text"], "additionalProperties": false,
              "properties": {
                "id": { "type": "string", "minLength": 1, "pattern": "^[a-zA-Z0-9_-]+$", "not": { "const": "dont-know" }, "maxLength": 120 },
                "text": { "type": "string", "minLength": 1, "maxLength": 300 }
              }
            }
          }
        }
      }
    },
    "points": {
      "type": "object", "required": ["right", "wrong", "unknown"], "additionalProperties": false,
      "properties": { "right": { "type": "number" , "multipleOf": 0.01}, "wrong": { "type": "number" , "multipleOf": 0.01}, "unknown": { "type": "number" , "multipleOf": 0.01} }
    }
  }
}
