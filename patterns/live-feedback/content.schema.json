{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Feedback while you type content",
  "type": "object",
  "required": [
    "prompt",
    "criteria"
  ],
  "additionalProperties": false,
  "properties": {
    "prompt": {
      "type": "string",
      "minLength": 1
    },
    "criteria": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "prefixItems": [
        {
          "$ref": "#/$defs/criterion",
          "properties": {
            "id": {
              "const": "three_actions"
            }
          }
        },
        {
          "$ref": "#/$defs/criterion",
          "properties": {
            "id": {
              "const": "observable"
            }
          }
        },
        {
          "$ref": "#/$defs/criterion",
          "properties": {
            "id": {
              "const": "when"
            }
          }
        },
        {
          "$ref": "#/$defs/criterion",
          "properties": {
            "id": {
              "const": "commitments"
            }
          }
        }
      ],
      "items": false
    }
  },
  "$defs": {
    "criterion": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "label",
        "short",
        "met",
        "missed",
        "unsure"
      ],
      "properties": {
        "id": {
          "type": "string",
          "enum": [
            "three_actions",
            "observable",
            "when",
            "commitments"
          ]
        },
        "label": {
          "type": "string",
          "minLength": 1
        },
        "short": {
          "type": "string",
          "minLength": 1
        },
        "met": {
          "type": "string",
          "minLength": 1
        },
        "missed": {
          "type": "string",
          "minLength": 1
        },
        "unsure": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
